rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTask(taskId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'title', 'notes', 'dueDate', 'dueTime', 'priority',
          'category', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'notes', 'dueDate', 'dueTime', 'priority',
          'category', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && data.id == taskId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.notes is string && data.notes.size() <= 500
        && data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.dueTime == null || (data.dueTime is string && data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && data.priority in ['low', 'normal', 'high']
        && data.category is string && data.category.size() <= 30
        && data.createdAt is string && data.updatedAt is string
        && (data.completedAt == null || data.completedAt is string);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if ownsUserData(userId);
      allow create: if ownsUserData(userId) && validTask(taskId);
      allow update: if ownsUserData(userId)
        && validTask(taskId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUserData(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
